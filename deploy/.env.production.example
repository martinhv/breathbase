# Production .env for the BreathBase app VM.
#
# On the VM:
#   cp deploy/.env.production.example .env
#   # fill in the values below from your Firebase project
#   docker compose up -d --build
#
# These values are baked into the JS bundle at build time (Vite inlines
# import.meta.env.VITE_*). They are NOT secrets — anything in a public web
# app is visible to its users. Restrict access via Firebase Auth rules and
# Authorized Domains, not by hiding the API key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Enables server-side push reminders via FCM. See README
# "Push reminders" for the matching Cloud Function deploy.
VITE_FIREBASE_VAPID_KEY=

# Optional. Set to "true" to force local mode (skip Firebase entirely and
# use window.localStorage). Leave empty in production unless you actually
# want a Firebase-less deploy.
VITE_LOCAL_MODE=

# Optional. Self-hosted Umami analytics. Set BOTH to activate. Without
# these the Privacy toggle in Settings is hidden and no analytics script
# loads. Users can still opt out via the toggle when these are set.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=

# Legal / Impressum / GDPR contact info. Required to render the Impressum
# and Privacy pages with real values; otherwise a clear placeholder shows
# instead. Inlined at build time via docker-compose build.args. None of
# these are secrets — they're displayed on a public legal page.
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS_STREET=
VITE_LEGAL_ADDRESS_CITY=
VITE_LEGAL_ADDRESS_COUNTRY=Germany
VITE_LEGAL_EMAIL=
VITE_LEGAL_MANAGING_DIRECTOR=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
# Optional — leave blank to hide the section.
VITE_LEGAL_VAT_ID=
# Defaults to BayLDA (Bavaria). Override for another jurisdiction.
VITE_LEGAL_SUPERVISORY_AUTHORITY=
VITE_LEGAL_SUPERVISORY_ADDRESS=
VITE_LEGAL_SUPERVISORY_URL=
