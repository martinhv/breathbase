# Production .env for the BreathBase app VM.
#
# On the VM:
#   cp deploy/.env.production.example .env
#   # fill in the values below from your Firebase project
#   docker compose up -d --build
#
# These values are baked into the JS bundle at build time (Vite inlines
# import.meta.env.VITE_*). They are NOT secrets — anything in a public web
# app is visible to its users. Restrict access via Firebase Auth rules and
# Authorized Domains, not by hiding the API key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Enables server-side push reminders via FCM. See README
# "Push reminders" for the matching Cloud Function deploy.
VITE_FIREBASE_VAPID_KEY=

# Optional. Set to "true" to force local mode (skip Firebase entirely and
# use window.localStorage). Leave empty in production unless you actually
# want a Firebase-less deploy.
VITE_LOCAL_MODE=
