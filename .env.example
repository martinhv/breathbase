# Firebase web-app credentials. Copy to .env.local and fill in.
# Find these under: Firebase Console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging VAPID key. Required ONLY to enable server-side
# push reminders that fire when the app is closed. Generate at:
#   Firebase Console → Project settings → Cloud Messaging →
#   Web configuration → Generate key pair
# Without this key, daily reminders fall back to client-side timers that
# only fire while a BreathBase tab is open. See README "Push reminders".
VITE_FIREBASE_VAPID_KEY=

# Local mode: skip Firebase entirely. The app runs with a synthetic local
# user and persists settings/sessions to window.localStorage. Auto-enabled
# whenever the VITE_FIREBASE_* keys above are all empty — set this to "true"
# to force it even when Firebase config is present.
# VITE_LOCAL_MODE=true

# Self-hosted Umami analytics. Set BOTH to activate. When unset, the
# Privacy section in Settings hides itself and no script is loaded.
# - WEBSITE_ID: the site UUID from your Umami admin
# - SCRIPT_URL: full URL to script.js (e.g. https://analytics.example.com/script.js)
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=

# ElevenLabs API key. Only used by scripts/generate-voice.sh at generation
# time — the running app never calls ElevenLabs. Get one from:
#   elevenlabs.io → profile → API key
ELEVENLABS_API_KEY=

# Google Cloud / Vertex AI Veo config. Only used by
# scripts/generate-welcome-video.sh at generation time. Veo 3.1 currently
# requires per-project allowlist on Vertex AI; veo-3.0-generate-001 is the
# GA fallback that works without an allowlist request.
GCLOUD_PROJECT=
GCLOUD_ACCOUNT=
VEO_LOCATION=us-central1
VEO_MODEL=veo-3.0-generate-001
VEO_BUCKET=

# Legal / Impressum / GDPR contact info. Required to render the Impressum
# and Privacy pages with real values; defaults to "[set VITE_LEGAL_*...]"
# placeholders if unset, so the pages still render but show clearly that
# they're not configured. Inlined at build time — do NOT commit real values;
# put them in .env.local only.
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS_STREET=
VITE_LEGAL_ADDRESS_CITY=
VITE_LEGAL_ADDRESS_COUNTRY=Germany
VITE_LEGAL_EMAIL=
VITE_LEGAL_MANAGING_DIRECTOR=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
# Optional. Leave blank to hide the section.
VITE_LEGAL_VAT_ID=
# Defaults to BayLDA (Bavaria). Set these to override for your own jurisdiction.
VITE_LEGAL_SUPERVISORY_AUTHORITY=
VITE_LEGAL_SUPERVISORY_ADDRESS=
VITE_LEGAL_SUPERVISORY_URL=
