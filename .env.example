# Firebase web-app credentials. Copy to .env.local and fill in.
# Find these under: Firebase Console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging VAPID key. Required ONLY to enable server-side
# push reminders that fire when the app is closed. Generate at:
#   Firebase Console → Project settings → Cloud Messaging →
#   Web configuration → Generate key pair
# Without this key, daily reminders fall back to client-side timers that
# only fire while a BreathBase tab is open. See README "Push reminders".
VITE_FIREBASE_VAPID_KEY=

# Local mode: skip Firebase entirely. The app runs with a synthetic local
# user and persists settings/sessions to window.localStorage. Auto-enabled
# whenever the VITE_FIREBASE_* keys above are all empty — set this to "true"
# to force it even when Firebase config is present.
# VITE_LOCAL_MODE=true
