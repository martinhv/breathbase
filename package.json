{
  "name": "sough",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sough — Foundational breathwork, grounded in science.",
  "author": {
    "name": "Martin Hirschvogel",
    "url": "https://github.com/martinhv"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinhv/sough.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-fcm-sw.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:init": "mkdir -p android && cd android && bubblewrap init --manifest https://sough.life/manifest.webmanifest",
    "android:build": "cd android && bubblewrap build",
    "android:fingerprint": "node scripts/android-fingerprint.mjs"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "framer-motion": "^11.11.17",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.28.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
